    "version": "0.2.0",
    "configurations": [
        {
            "name": "ems_tp",
            "request": "launch",
            "type": "dart",
          "args": ["--web-port", "8868", "--dart-define=billingGen=3"],
        },
        {
            "name": "ems_tp (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
                        "args": ["--dart-define=billingGen=2"],
        },
        {
            "name": "ems_tp (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": ["--dart-define=billingGen=2"]
        }
    ]
}
